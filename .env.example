# StoryForge / NarrateAnimateAwesomeGreat
# Copy this file to .env and fill only the providers you actually use.
# NEVER commit your real .env file.

# ----------------------------
# Core
# ----------------------------
STORYFORGE_PROJECTS_DIR=projects
STORYFORGE_DEFAULT_PROVIDER=veo
STORYFORGE_DEFAULT_RESOLUTION=720p
STORYFORGE_DEFAULT_ASPECT_RATIO=16:9
STORYFORGE_DEFAULT_DURATION=6
STORYFORGE_MAX_PARALLEL_GENERATIONS=1
STORYFORGE_POLL_SECONDS=10

# ----------------------------
# Google Gemini / Veo
# Gemini API billing is separate from the consumer Gemini app subscription.
# Create an API key in Google AI Studio when you want API automation.
# ----------------------------
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
VEO_RESOLUTION=720p
VEO_ASPECT_RATIO=16:9

# ----------------------------
# Runway
# ----------------------------
RUNWAYML_API_SECRET=
RUNWAY_MODEL=gen4_turbo
RUNWAY_RATIO=1280:720
RUNWAY_DURATION=5

# ----------------------------
# Generic HTTP video provider
# Use this to connect a future vendor without changing StoryForge core.
# Expected contract is documented in docs/PROVIDERS.md.
# ----------------------------
GENERIC_VIDEO_API_URL=
GENERIC_VIDEO_API_KEY=
GENERIC_VIDEO_MODEL=

# ----------------------------
# Local tools
# ----------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
REALESRGAN_BIN=realesrgan-ncnn-vulkan
COMFYUI_URL=http://127.0.0.1:8188
WAN_WORKFLOW_JSON=

# ----------------------------
# MCP server
# stdio is recommended for local desktop/IDE hosts.
# streamable-http is useful when serving remotely.
# ----------------------------
STORYFORGE_MCP_TRANSPORT=stdio
STORYFORGE_MCP_HOST=127.0.0.1
STORYFORGE_MCP_PORT=8765
STORYFORGE_MCP_PATH=/mcp
