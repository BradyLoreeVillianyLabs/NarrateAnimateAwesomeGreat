# StoryForge / NarrateAnimateAwesomeGreat
# Copy this file to .env and fill only the providers you actually use.
# NEVER commit your real .env file.

# ----------------------------
# Core / economics
# ----------------------------
STORYFORGE_PROJECTS_DIR=projects
STORYFORGE_DEFAULT_PROVIDER=flow
STORYFORGE_DEFAULT_RESOLUTION=720p
STORYFORGE_DEFAULT_ASPECT_RATIO=16:9
STORYFORGE_DEFAULT_DURATION=6
STORYFORGE_MAX_PARALLEL_GENERATIONS=1
STORYFORGE_POLL_SECONDS=10

# Prefer already-paid subscription generation and local tools first.
STORYFORGE_USE_FLOW_SUBSCRIPTION=1
STORYFORGE_ENABLE_PAID_API=0

# Hard project budget for separately billed APIs. Flow/local routes are tracked
# as $0 incremental by default because they use already-paid subscriptions or
# local hardware. Change values only if you want different accounting.
STORYFORGE_MAX_PROJECT_GENERATION_USD=20.00
STORYFORGE_FLOW_INCREMENTAL_USD_PER_SECOND=0.00
STORYFORGE_LOCAL_VIDEO_USD_PER_SECOND=0.00
STORYFORGE_CHEAP_CLOUD_USD_PER_SECOND=0.05
STORYFORGE_HERO_CLOUD_USD_PER_SECOND=0.15

# Optional provider-specific rates used only for a final safety estimate when
# STORYFORGE_ENABLE_PAID_API=1. Keep them current if you enable paid APIs.
STORYFORGE_VEO_USD_PER_SECOND=0.05
STORYFORGE_RUNWAY_USD_PER_SECOND=0.05
STORYFORGE_GENERIC_USD_PER_SECOND=0.05

# ----------------------------
# StoryForge Studio
# Default is localhost only. Do not expose Studio to a network unless you add
# authentication/reverse-proxy controls appropriate for your environment.
# ----------------------------
STORYFORGE_STUDIO_HOST=127.0.0.1
STORYFORGE_STUDIO_PORT=8766

# ----------------------------
# Google Flow / Veo subscription workflow
# No API key is required for packet export. StoryForge prepares files for
# manual use in Flow, then expects downloaded clips in generated/scene_###.mp4.
# ----------------------------
FLOW_PREFERRED_TIER=veo-lite
FLOW_PREFERRED_DURATION=8
FLOW_UPSCALE_WHEN_INCLUDED=1

# ----------------------------
# Google Gemini / Veo API (SEPARATELY BILLED)
# This remains disabled unless STORYFORGE_ENABLE_PAID_API=1.
# ----------------------------
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
VEO_RESOLUTION=720p
VEO_ASPECT_RATIO=16:9

# ----------------------------
# Runway API (SEPARATELY BILLED)
# ----------------------------
RUNWAYML_API_SECRET=
RUNWAY_MODEL=gen4_turbo
RUNWAY_RATIO=1280:720
RUNWAY_DURATION=5

# ----------------------------
# Generic HTTP video provider
# ----------------------------
GENERIC_VIDEO_API_URL=
GENERIC_VIDEO_API_KEY=
GENERIC_VIDEO_MODEL=

# ----------------------------
# Local tools
# ----------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
REALESRGAN_BIN=realesrgan-ncnn-vulkan
COMFYUI_URL=http://127.0.0.1:8188
WAN_WORKFLOW_JSON=

# ----------------------------
# MCP server
# ----------------------------
STORYFORGE_MCP_TRANSPORT=stdio
STORYFORGE_MCP_HOST=127.0.0.1
STORYFORGE_MCP_PORT=8765
STORYFORGE_MCP_PATH=/mcp
